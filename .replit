entrypoint = "README.md"
run = "python backend/run.py"

[nix]
channel = "stable-24_11"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
build = "npm --prefix frontend ci && npm --prefix frontend run build && python -m pip install --no-cache-dir -r backend/requirements.txt"
run = "python backend/run.py"
